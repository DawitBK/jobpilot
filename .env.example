# Copy to .env for local development. Never commit a real .env.
#
# Two database roles, as in production:
#   MIGRATION_DATABASE_URL  the schema owner; only `db:migrate` uses it.
#   DATABASE_URL            the runtime role `jobpilot_app`. It must NOT be a superuser and must NOT have
#                           BYPASSRLS, or row-level security (tenant isolation) is not enforced. Create it
#                           once, as the owner, before migrating (the migrations grant to it if it exists):
#     CREATE ROLE jobpilot_app LOGIN NOSUPERUSER NOBYPASSRLS PASSWORD '<a real password>';
MIGRATION_DATABASE_URL=postgres://jobpilot:jobpilot@localhost:5432/jobpilot
DATABASE_URL=postgres://jobpilot_app:change-me@localhost:5432/jobpilot
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
PORT=3000
LOG_LEVEL=info
# How many reverse proxies sit in front of the API (0 when it is reached directly). Only then is X-Forwarded-For believed.
TRUST_PROXY_HOPS=0

# ---- Added with the notification, billing, two-step and AI work ----
# Encrypts two-step sign-in secrets and an organization's own credentials (AES-256-GCM). 32 random bytes, base64:
#   openssl rand -base64 32
# Without it those two features say so (503) instead of storing anything in the clear. When rotating, keep the old key in
# SECRETS_KEY_PREVIOUS until stored values have been written again.
SECRETS_KEY=
#SECRETS_KEY_PREVIOUS=
# How often the outbox dispatcher looks for new events (milliseconds); 0 turns the loop off.
OUTBOX_POLL_MS=2000
# How often to look for job sources that are due, in ms (each source has its own interval); 0 turns the schedule off.
SOURCES_POLL_MS=60000
# Email for the notifications that deserve one. Without SMTP_URL they stay in the app. APP_URL and MAIL_FROM are required with it.
#SMTP_URL=smtps://user:password@mail.example.com:465
#MAIL_FROM=JobPilot <no-reply@example.com>
#APP_URL=https://jobpilot.example.com
# AI drafting: a platform-wide Anthropic key, used when an organization has stored none of its own (Settings > AI writing).
#ANTHROPIC_API_KEY=
#AI_MODEL=claude-sonnet-5-5
# Sign-in rate limits are on by default. Turn them off ONLY on a development machine (seeding and the browser tests sign in a lot).
#RATE_LIMIT=off
# The web app (apps/web): where it reaches the API, and extra hosts the dev server accepts.
#API_URL=http://127.0.0.1:3000
#DEV_ORIGINS=127.0.0.1
